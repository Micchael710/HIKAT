{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.hikat.launcher",
  "productName": "HiKAT Launcher",
  "copyright": "Copyright © 2026 HiKAT Team",
  "electronDist": "node_modules/electron/dist",
  "directories": {
    "output": "dist-installer"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "icon": "installer/resources/icon.png",
    "executableName": "HiKAT Launcher",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowElevation": true,
    "differentialPackage": false,
    "deleteAppDataOnUninstall": false,
    "shortcutName": "HiKAT Launcher",
    "uninstallDisplayName": "HiKAT Launcher",
    "createStartMenuShortcut": true,
    "artifactName": "HiKAT Launcher Setup ${version}.${ext}",
    "installerHeader": "installer/resources/installerHeader.bmp",
    "installerSidebar": "installer/resources/installerSidebar.bmp",
    "uninstallerSidebar": "installer/resources/installerSidebar.bmp",
    "warningsAsErrors": false,
    "include": "installer/customInstall.nsh"
  }
}

