# HiKAT Environment Variables Example
# Duplicate this file to .env or configure in Cloudflare / Fly dashboards.
# DO NOT COMMIT REAL CREDENTIALS OR TOKENS TO GIT.

# Environment
NODE_ENV=development
ENVIRONMENT=development

# Cloudflare Configuration (Examples)
CLOUDFLARE_ACCOUNT_ID=example_account_id
CLOUDFLARE_API_TOKEN=example_cloudflare_token

# Authentication Provider (OAuth)
GOOGLE_CLIENT_ID=example-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=example-google-client-secret
DISCORD_CLIENT_ID=example-discord-client-id
DISCORD_CLIENT_SECRET=example-discord-client-secret

# Asymmetric JWT Keys (ECDSA ES256)
# Private key is ONLY configured in services/auth for signing tokens:
AUTH_JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nEXAMPLE_PRIVATE_KEY\n-----END PRIVATE KEY-----"
# Public key or JWKS endpoint configured in verifiers (Backend, Server Mod):
AUTH_JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nEXAMPLE_PUBLIC_KEY\n-----END PUBLIC KEY-----"
AUTH_JWKS_URL=http://localhost:8788/.well-known/jwks.json

# Backend & GraphQL
GRAPHQL_ENDPOINT=http://localhost:8787/graphql
AUTH_SERVICE_ENDPOINT=http://localhost:8788

# Vite Client Frontend Apps (Launcher & Backoffice)
VITE_AUTH_API_URL=http://localhost:8788
VITE_BACKEND_API_URL=http://localhost:8787

# Local Development Admin Provisioning (pnpm local:create-admin)
# Optional: HIKAT_LOCAL_ADMIN_EMAIL=admin@hikat.local
# Optional: HIKAT_LOCAL_ADMIN_PASSWORD=your_custom_local_password

# Storage (R2 / D1)
R2_BUCKET_NAME=hikat-assets
D1_DATABASE_ID=example-d1-uuid
# Cloudflare R2 Parent S3 Credentials for generating temporary scoped credentials
R2_PARENT_ACCESS_KEY_ID=example_r2_access_key_id
R2_PARENT_SECRET_ACCESS_KEY=example_r2_secret_access_key

# Game Infrastructure (Pterodactyl / Fly)
PTERODACTYL_BASE_URL=https://panel.example.com
PTERODACTYL_API_KEY=ptlc_example_pterodactyl_client_key
PTERODACTYL_APP_API_KEY=ptla_example_pterodactyl_application_key
PTERODACTYL_SERVER_ID=example_fallback_server_identifier
PTERODACTYL_DEFAULT_OWNER_ID=1
PTERODACTYL_DEFAULT_LOCATION_ID=1
PTERODACTYL_EGG_VANILLA_ID=3
PTERODACTYL_EGG_FORGE_ID=1
PTERODACTYL_EGG_NEOFORGE_ID=15
PTERODACTYL_EGG_FABRIC_ID=16
PTERODACTYL_EGG_QUILT_ID=18
# Optional override: If set, overrides automatic Java detection based on Mojang metadata.
# Leave empty or commented to automatically use the correct Java version (e.g. java_21, java_17, etc.)
# PTERODACTYL_DEFAULT_DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_21
FLY_API_TOKEN=example_fly_token

