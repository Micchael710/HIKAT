{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hikat-backend",
  "account_id": "947763b6e2e22822ea37c64385dbe604",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "AUTH_ISSUER": "https://auth.hikat.org",
    "AUTH_JWKS_URL": "https://auth.hikat.org/.well-known/jwks.json"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hikat-d1",
      "database_id": "a2410123-4e73-4c0f-9263-412fa06d7bdc",
      "migrations_dir": "../../packages/database/migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "hikat-r2",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELEASE_EVENTS",
        "class_name": "ReleaseEventsDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "release-events-v1",
      "new_sqlite_classes": [
        "ReleaseEventsDurableObject"
      ]
    }
  ]
}