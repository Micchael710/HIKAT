{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hikat-backend",
  "account_id": "947763b6e2e22822ea37c64385dbe604",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_ISSUER": "https://auth.hikat.org",
    "AUTH_JWKS_URL": "https://auth.hikat.org/.well-known/jwks.json",
    "PTERODACTYL_BASE_URL": "https://hikat-panel.ddns.net",
    "CORS_ALLOW_ORIGIN": "http://localhost:5174,http://127.0.0.1:5174",
    "PTERODACTYL_DEFAULT_OWNER_ID": "2",
    "PTERODACTYL_DEFAULT_LOCATION_ID": "1",
    "PTERODACTYL_EGG_VANILLA_ID": "3",
    "PTERODACTYL_EGG_FORGE_ID": "1",
    "PTERODACTYL_EGG_NEOFORGE_ID": "15",
    "PTERODACTYL_EGG_FABRIC_ID": "16",
    "PTERODACTYL_EGG_QUILT_ID": "18"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hikat-d1",
      "database_id": "a2410123-4e73-4c0f-9263-412fa06d7bdc",
      "migrations_dir": "../../packages/database/migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "hikat-r2",
      "remote": true
    }
  ],
  "routes": [
    {
      "pattern": "api.hikat.org",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELEASE_EVENTS",
        "class_name": "ReleaseEventsDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "release-events-v1",
      "new_sqlite_classes": [
        "ReleaseEventsDurableObject"
      ]
    }
  ]
}