{
  "name": "@hikat/backend-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HiKAT Backend Service - Cloudflare Worker + GraphQL Yoga shell",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to ../../.wrangler/state --var ENVIRONMENT:development --var AUTH_JWKS_URL:http://localhost:8788/.well-known/jwks.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hikat/database": "workspace:*",
    "@hikat/graphql": "workspace:*",
    "@hikat/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.13.1",
    "jose": "^6.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@hikat/config": "workspace:*",
    "fast-png": "^6.2.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.128.0"
  }
}
