{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hikat-auth",
  "account_id": "947763b6e2e22822ea37c64385dbe604",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_SERVICE_ENDPOINT": "https://auth.hikat.org",
    "AUTH_JWT_KID": "hikat-prod-key-1",
    "GOOGLE_CLIENT_ID": "83020174882-jsoh32a4n7ct9bn733ebor6r2mkkcpf3.apps.googleusercontent.com",
    "DISCORD_CLIENT_ID": "1544169716183080981",
    "EMAIL_FROM": "HiKAT <noreply@mail.hikat.org>",
    "CORS_ALLOW_ORIGIN": "http://localhost:8443,http://127.0.0.1:8443,http://localhost:5174,http://127.0.0.1:5174"
  },
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hikat-d1",
      "database_id": "a2410123-4e73-4c0f-9263-412fa06d7bdc",
      "migrations_dir": "../../packages/database/migrations"
    }
  ]
}