{
  "name": "@hikat/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HiKAT single source of truth for Drizzle ORM schema, migrations, and D1 database client",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./testUtils": "./src/testUtils.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hikat-d1 --local --config ../../services/backend/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hikat/shared": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@hikat/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
