{
  "name": "hikat-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "vitest run",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "format": "oxfmt .",
    "db:generate": "pnpm --filter @hikat/database db:generate",
    "db:migrate:local": "pnpm --filter @hikat/backend-service exec wrangler d1 migrations apply hikat-d1 --local --persist-to ../../.wrangler/state",
    "local:create-admin": "tsx scripts/createAdmin.ts",
    "admin:promote": "tsx scripts/promoteAdmin.ts",
    "dev:auth": "pnpm --filter @hikat/auth-service dev",
    "dev:backend": "pnpm --filter @hikat/backend-service dev",
    "dev:backoffice": "pnpm --filter hikat-backoffice dev",
    "dev:launcher": "node scripts/devLauncher.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.20.0",
    "oxfmt": "^0.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@xmcl/file-transfer@2.1.2": "patches/@xmcl__file-transfer@2.1.2.patch"
    }
  }
}
