{
  "name": "hikat-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "vitest run",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "format": "oxfmt .",
    "db:generate": "pnpm --filter @hikat/database db:generate",
    "db:migrate:local": "pnpm --filter @hikat/backend-service exec wrangler d1 migrations apply hikat-d1 --local"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
